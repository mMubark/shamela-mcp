# Auto detect text files and perform LF normalization
* text=auto

# Batch files MUST be CRLF. cmd.exe mis-parses LF-only .bat files: labels stop
# resolving and the console window closes with no message at all. Checked by
# tests/test_batch_files.py, which also forbids non-ASCII bytes in these files.
*.bat text eol=crlf

# Console message files are streamed with `type` on Windows, so keep CRLF here too.
assets/*.txt text eol=crlf

# The shipped helper is binary
*.jar binary
